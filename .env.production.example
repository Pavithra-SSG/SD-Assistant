# Copy to .env.production on the server, fill in, and keep it out of git (chmod 600).
# Used twice: by `docker compose --env-file .env.production` (for ${...} in docker-compose.yml)
# and inside the containers (env_file). Generate each secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Database passwords: letters and digits only (they go inside a URL).

# ================================================================ required
APP_ENV=production
APP_VERSION=4.0.0
# Leave unset to build on this server. With CD (docs/DEPLOY.md "Automatic deployment"), the pipeline sets
# APP_IMAGE=ghcr.io/pavithra-ssg/sd-assistant and APP_VERSION=<commit SHA> for you.
# APP_IMAGE=
SITE_ADDRESS=servicedesk.company.com
SITE_URL=https://servicedesk.company.com
# "internal" (private network, Caddy's own CA) or an e-mail address for a public Let's Encrypt certificate
CADDY_TLS=internal
JWT_SECRET=replace-with-48-random-characters
POSTGRES_PASSWORD=replace-owner-password-letters-and-digits
# The account the app connects as (can't change tables or edit the audit log)
DB_APP_PASSWORD=replace-app-password-letters-and-digits
TYPESAFE_API_KEY=your-key-from-console.typesafe.ai
# Pin the model you evaluated; jev-latest moves when TypeSafe ships a release
TYPESAFE_MODEL=jev-1.13.0

# ================================================================ strongly recommended before go-live
# E-mail to employees when their ticket needs them (any SMTP relay: Microsoft 365, Google, your mail server)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=IT Service Desk <itsupport@company.com>
# Teams channel for P1/P2 alerts: channel ⋯ → Workflows → "Post to a channel when a webhook request is received"
TEAMS_WEBHOOK_URL=
# Where the watchdog reports "service desk is down" (defaults to TEAMS_WEBHOOK_URL) and/or an e-mail address
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=
# Outside dead-man's switch, e.g. a free check at healthchecks.io (alerts you if even the server is down)
HEALTHCHECK_PING_URL=

# ================================================================ optional (defaults shown)
# DB_REPORTING_PASSWORD=       read-only account for BI tools (reporting views only); empty = not created
# POSTGRES_DB=servicedesk
# POSTGRES_USER=servicedesk
# TIMEZONE=Asia/Kolkata
# BUSINESS_HOURS=09:00-18:00
# BUSINESS_DAYS=Mon-Fri
# HOLIDAYS_FILE=               path inside the container to a file of YYYY-MM-DD dates
# SLA_24X7_PRIORITIES=P1
# SLA_24X7_CATEGORIES=CAT-01,CAT-05,CAT-09   sign-in, MFA and security never wait for Monday
# RETENTION_MONTHS=24          personal text removed from tickets this long after they close
# ATTACHMENT_RETENTION_DAYS=90 screenshots deleted after this many days
# ATTACHMENT_MAX_MB=10
# OCR_ENABLED=1
# EMAIL_EMPLOYEES=1
# EMAIL_STAFF=0
# DOCS_ENABLED=0
# LOG_LEVEL=INFO
# LOGIN_RATE_PER_MINUTE=20
# PASSWORD_MIN_LENGTH=12
# PASSWORD_BLOCKLIST_FILE=
# SELF_SERVICE_RESET=0         keep 0 until a real identity provider replaces the simulated tools
# WORKER_INTERVAL_SECONDS=15
# BACKUP_KEEP_DAYS=14
# BACKUP_INTERVAL_SECONDS=86400
